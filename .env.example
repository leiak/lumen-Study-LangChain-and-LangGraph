# ====== LLM 优先级: LLM_PROVIDER 强制 > Anthropic > DeepSeek > MiniMax > OpenAI ======
# 默认 MiniMax M3(国内代理 + OpenAI 兼容协议)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3

# ====== DeepSeek (OpenAI 兼容协议,base_url 固定 https://api.deepseek.com/v1) ======
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ====== 强制 provider (可选) ======
# 留空 = 按 key 自动选 (Anthropic > DeepSeek > MiniMax > OpenAI)
# 设了 = 无视任何 shell env 强制走这个 provider,适合 shell 被 Claude Code 全局 env 污染的场景
# 可选: anthropic / deepseek / minimax / openai
# LLM_PROVIDER=deepseek

# ====== LangSmith (L3 需要) ======
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=0401-langchain-langgraph-v1
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ====== OpenAI 兼容备选 (切换时改这里) ======
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ====== Ollama 本地备选 ======
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# LangChain 检测到 LANGSMITH_API_KEY (或旧名 LANGCHAIN_API_KEY) 后会自动把每次 invoke 上报到 api.smith.langchain.com。403 Forbidden =
# LANGCHAIN_TRACING_V2=false
